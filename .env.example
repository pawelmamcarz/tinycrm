# Skopiuj do .env i uzupełnij. Sekrety NIGDY do gita.
DJANGO_SECRET_KEY=zmien-mnie
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://tinycrm:tinycrm@localhost:5432/tinycrm
# Puste = Celery w trybie eager (zadania synchronicznie, bez workera)
REDIS_URL=
# Adres bazowy do linków w mailach (np. https://crm.example.com)
SITE_URL=
# AI: bez klucza aplikacja działa w trybie demo (ekstrakcja heurystyczna)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Speech-to-text: demo | elevenlabs | openai
STT_PROVIDER=demo
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
VOICE_AUDIO_RETENTION_DAYS=30
# Web Push (VAPID) — opcjonalnie. Wygeneruj parę: .venv/bin/python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# enova365 Dynamic WebAPI — opcjonalnie (puste ENOVA_BASE_URL = codzienna synchronizacja wyłączona)
ENOVA_BASE_URL=
ENOVA_API_TOKEN=
# Slug organizacji synchronizowanej z enova (puste = jedyna organizacja w systemie)
ENOVA_ORG_SLUG=
# Ścieżka i rozmiar strony WebAPI (puste = /api/Kontrahenci, 100)
# ENOVA_KONTRAHENCI_ENDPOINT=/api/Kontrahenci
# ENOVA_PAGE_SIZE=100

# Wdrożenie (Railway): config.settings.production wymaga DJANGO_SECRET_KEY;
# domenę bierze z RAILWAY_PUBLIC_DOMAIN. DEMO_PASSWORD ustawione = seed_demo przy starcie.
# DEMO_PASSWORD=
