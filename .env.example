# Skopiuj do .env i uzupełnij. Sekrety NIGDY do gita.
DJANGO_SECRET_KEY=zmien-mnie
DJANGO_DEBUG=1
DATABASE_URL=postgres://tinycrm:tinycrm@localhost:5432/tinycrm
REDIS_URL=
# AI: bez klucza aplikacja działa w trybie demo (ekstrakcja heurystyczna)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Speech-to-text: demo | elevenlabs | openai
STT_PROVIDER=demo
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Web Push (VAPID) — opcjonalnie
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# enova365 Dynamic WebAPI — opcjonalnie
ENOVA_BASE_URL=
ENOVA_API_TOKEN=
